<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>星際寶石獵人 Cyber Catcher</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; }
        body {
            background-color: #070714;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            touch-action: none;
        }
        #game-container {
            position: relative;
            width: 100%;
            max-width: 450px;
            height: 100vh;
            max-height: 800px;
            background: radial-gradient(circle at center, #141432 0%, #070714 100%);
            box-shadow: 0 0 30px rgba(0, 255, 204, 0.2);
            overflow: hidden;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        .ui-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
        }
        .hud {
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: bold;
            text-shadow: 0 0 8px #00ffcc;
        }
        .coin-badge { color: #ffd700; text-shadow: 0 0 8px #ffaa00; }
        .modal {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(15, 15, 35, 0.92);
            border: 2px solid #00ffcc;
            border-radius: 16px;
            padding: 28px 20px;
            width: 85%;
            text-align: center;
            box-shadow: 0 0 25px rgba(0, 255, 204, 0.4);
            pointer-events: auto;
        }
        .hidden { display: none !important; }
        h1 { font-size: 26px; margin-bottom: 10px; color: #00ffcc; text-shadow: 0 0 12px #00ffcc; }
        p { font-size: 14px; color: #cccccc; margin-bottom: 20px; line-height: 1.5; }
        .btn {
            display: block;
            width: 100%;
            padding: 13px;
            margin: 10px 0;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.1s, box-shadow 0.2s;
        }
        .btn:active { transform: scale(0.96); }
        .btn-primary {
            background: linear-gradient(90deg, #00ffcc, #0099ff);
            color: #050510;
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.5);
        }
        .btn-ad {
            background: linear-gradient(90deg, #ff9900, #ff3366);
            color: #ffffff;
            box-shadow: 0 0 15px rgba(255, 51, 102, 0.5);
        }
        .btn-shop {
            background: rgba(255, 215, 0, 0.15);
            border: 1px solid #ffd700;
            color: #ffd700;
        }
    </style>
</head>
<body>

<div id="game-container">
    <canvas id="gameCanvas"></canvas>

    <!-- 頂部狀態列 -->
    <div class="ui-layer">
        <div class="hud">
            <div id="scoreDisplay">分數: 0</div>
            <div class="coin-badge" id="coinDisplay">💰 寶石: 0</div>
        </div>
    </div>

    <!-- 開始選單 -->
    <div id="startModal" class="modal">
        <h1>星際寶石獵人</h1>
        <p>左右滑動或移動滑鼠控制能量盾<br>接住<span style="color:#00ffcc">翠綠能量(+10)</span>與<span style="color:#ffd700">黃金寶石(+50)</span><br>閃避<span style="color:#ff3366">赤紅隕石</span>！</p>
        <button class="btn btn-primary" onclick="startGame()">開始挑戰</button>
        <button class="btn btn-shop" onclick="upgradeShield()">⚡ 升級護盾寬度 (花費 10 寶石)</button>
    </div>

    <!-- 結算與變現選單 -->
    <div id="gameOverModal" class="modal hidden">
        <h1 style="color:#ff3366; text-shadow: 0 0 12px #ff3366;">任務失敗</h1>
        <p id="finalScoreText">本次得分: 0</p>
        <!-- 廣告變現預留按鈕 -->
        <button id="reviveBtn" class="btn btn-ad" onclick="watchAdToRevive()">🎬 觀看廣告原地復活 (雙倍得分)</button>
        <button class="btn btn-primary" onclick="startGame()">重新開始</button>
        <button class="btn btn-shop" onclick="upgradeShield()">⚡ 升級護盾寬度 (花費 10 寶石)</button>
    </div>
</div>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const scoreDisplay = document.getElementById('scoreDisplay');
    const coinDisplay = document.getElementById('coinDisplay');
    const startModal = document.getElementById('startModal');
    const gameOverModal = document.getElementById('gameOverModal');
    const finalScoreText = document.getElementById('finalScoreText');
    const reviveBtn = document.getElementById('reviveBtn');

    // 畫布尺寸自適應
    function resizeCanvas() {
        const container = document.getElementById('game-container');
        canvas.width = container.clientWidth;
        canvas.height = container.clientHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // 遊戲狀態與存檔讀取
    let gameRunning = false;
    let score = 0;
    let scoreMultiplier = 1;
    let totalCoins = parseInt(localStorage.getItem('cyber_coins') || '0');
    let shieldBonus = parseInt(localStorage.getItem('cyber_shield_bonus') || '0');
    let revivedThisRun = false;

    coinDisplay.innerText = `💰 寶石: ${totalCoins}`;

    // 玩家能量盾設定
    const player = {
        width: 85 + shieldBonus,
        height: 16,
        x: canvas.width / 2 - 42,
        y: canvas.height - 90,
        color: '#00ffcc'
    };

    let items = [];
    let particles = [];
    let frameCount = 0;
    let baseSpeed = 3.5;

    // 操控監聽（支援滑鼠與手機觸控）
    function movePlayer(clientX) {
        const rect = canvas.getBoundingClientRect();
        const relativeX = clientX - rect.left;
        player.x = Math.max(0, Math.min(canvas.width - player.width, relativeX - player.width / 2));
    }
    window.addEventListener('mousemove', (e) => { if (gameRunning) movePlayer(e.clientX); });
    window.addEventListener('touchmove', (e) => {
        if (gameRunning && e.touches.length > 0) movePlayer(e.touches[0].clientX);
    }, { passive: true });

    // 產生掉落物
    function spawnItem() {
        const rand = Math.random();
        let type = 'energy'; // 60% 翠綠能量
        let radius = 11;
        let color = '#00ffcc';

        if (rand > 0.65 && rand <= 0.88) {
            type = 'meteor'; // 23% 赤紅隕石
            radius = 15;
            color = '#ff3366';
        } else if (rand > 0.88) {
            type = 'gem';    // 12% 黃金寶石
            radius = 10;
            color = '#ffd700';
        }

        items.push({
            x: Math.random() * (canvas.width - radius * 2) + radius,
            y: -20,
            radius: radius,
            type: type,
            color: color,
            speed: (baseSpeed + Math.random() * 2) * (1 + score / 1500)
        });
    }

    // 產生粒子爆炸特效
    function createParticles(x, y, color) {
        for (let i = 0; i < 12; i++) {
            particles.push({
                x: x,
                y: y,
                vx: (Math.random() - 0.5) * 7,
                vy: (Math.random() - 0.5) * 7,
                alpha: 1,
                color: color
            });
        }
    }

    // 開始遊戲
    function startGame() {
        score = 0;
        scoreMultiplier = 1;
        revivedThisRun = false;
        items = [];
        particles = [];
        player.width = 85 + shieldBonus;
        player.y = canvas.height - 90;
        gameRunning = true;
        startModal.classList.add('hidden');
        gameOverModal.classList.add('hidden');
        scoreDisplay.innerText = `分數: ${score}`;
        requestAnimationFrame(gameLoop);
    }

    // 遊戲結束
    function triggerGameOver() {
        gameRunning = false;
        finalScoreText.innerText = `本次得分: ${score} (倍率 x${scoreMultiplier})`;
        reviveBtn.style.display = revivedThisRun ? 'none' : 'block';
        gameOverModal.classList.remove('hidden');
    }

    // 【變現接口 1】觀看廣告復活
    function watchAdToRevive() {
        // 未來串接廣告平臺 (如 CrazyGames / Poki / Adsgram) 時，把廣告觸發程式碼放這裡
        alert('【模擬廣告播放】感謝觀看 15 秒廣告！已獲得原地復活＋雙倍得分狀態！');
        revivedThisRun = true;
        scoreMultiplier = 2;
        items = [];
        gameRunning = true;
        gameOverModal.classList.add('hidden');
        requestAnimationFrame(gameLoop);
    }

    // 【變現接口 2】商店升級與內購
    function upgradeShield() {
        if (totalCoins >= 10) {
            totalCoins -= 10;
            shieldBonus += 15;
            localStorage.setItem('cyber_coins', totalCoins);
            localStorage.setItem('cyber_shield_bonus', shieldBonus);
            coinDisplay.innerText = `💰 寶石: ${totalCoins}`;
            player.width = 85 + shieldBonus;
            alert(`升級成功！護盾寬度已永久增加至 ${player.width}！`);
        } else {
            alert('寶石不足！在遊戲中多接一點黃金寶石（未來這裡可串接 Telegram Stars 或 PayPal 購買寶石）！');
        }
    }

    // 主迴圈
    function gameLoop() {
        if (!gameRunning) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        frameCount++;
        const spawnRate = Math.max(20, 48 - Math.floor(score / 200));
        if (frameCount % spawnRate === 0) spawnItem();

        // 繪製玩家護盾
        ctx.save();
        ctx.shadowBlur = 15;
        ctx.shadowColor = player.color;
        ctx.fillStyle = player.color;
        ctx.beginPath();
        ctx.roundRect(player.x, player.y, player.width, player.height, 8);
        ctx.fill();
        ctx.restore();

        // 更新與繪製掉落物
        for (let i = items.length - 1; i >= 0; i--) {
            let it = items[i];
            it.y += it.speed;

            ctx.save();
            ctx.shadowBlur = 12;
            ctx.shadowColor = it.color;
            ctx.fillStyle = it.color;
            ctx.beginPath();
            ctx.arc(it.x, it.y, it.radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();

            // 碰撞偵測
            if (
                it.y + it.radius >= player.y &&
                it.y - it.radius <= player.y + player.height &&
                it.x + it.radius >= player.x &&
                it.x - it.radius <= player.x + player.width
            ) {
                createParticles(it.x, it.y, it.color);
                if (it.type === 'energy') {
                    score += 10 * scoreMultiplier;
                } else if (it.type === 'gem') {
                    score += 50 * scoreMultiplier;
                    totalCoins += 1;
                    localStorage.setItem('cyber_coins', totalCoins);
                    coinDisplay.innerText = `💰 寶石: ${totalCoins}`;
                } else if (it.type === 'meteor') {
                    triggerGameOver();
                    return;
                }
                scoreDisplay.innerText = `分數: ${score}`;
                items.splice(i, 1);
                continue;
            }

            if (it.y > canvas.height + 30) items.splice(i, 1);
        }

        // 更新與繪製粒子特效
        for (let i = particles.length - 1; i >= 0; i--) {
            let p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.alpha -= 0.04;
            if (p.alpha <= 0) {
                particles.splice(i, 1);
                continue;
            }
            ctx.fillStyle = p.color;
            ctx.globalAlpha = p.alpha;
            ctx.beginPath();
            ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);
            ctx.fill();
            ctx.globalAlpha = 1;
        }

        requestAnimationFrame(gameLoop);
    }
</script>
</body>
</html>
